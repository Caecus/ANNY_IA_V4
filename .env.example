# Variables de entorno para ANNY App V4

# Google Maps API Key - REQUERIDO
EXPO_PUBLIC_GOOGLE_MAP_KEY=TU_GOOGLE_MAPS_API_KEY_AQUI

# URLs de Backend APIs
EXPO_PUBLIC_APP_API_URL=http://3.15.63.191:7003
EXPO_PUBLIC_APP_API_URL_PORT=http://3.15.63.191:7001
EXPO_PUBLIC_APP_API_URL_TWO=http://3.15.63.191:7002
EXPO_PUBLIC_APP_API_URL_GLASSES=http://3.15.63.191:7004
EXPO_PUBLIC_APP_API_URL_INTERSECTIONS=http://3.15.63.191:7005

# Configuraciones de GPS
EXPO_PUBLIC_GPS_HIGH_ACCURACY=true

# Firebase y otras APIs (si las usas)
EXPO_PUBLIC_ONESIGNAL_APP_ID=tu_onesignal_app_id
EXPO_PUBLIC_KAIROS_API_KEY=tu_kairos_api_key

# Configuración de desarrollo
NODE_ENV=development